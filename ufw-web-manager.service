[Unit]
Description=UFW Web Manager 1.1
After=network.target ufw.service
Wants=ufw.service

[Service]
Type=simple
User=ufwweb
Group=ufwweb
WorkingDirectory=/opt/ufw-web-manager
Environment=UFW_WEB_HOST=__UFW_WEB_HOST__
Environment=UFW_WEB_PORT=__UFW_WEB_PORT__
ExecStart=/opt/ufw-web-manager/.venv/bin/python /opt/ufw-web-manager/app.py
Restart=on-failure
RestartSec=3
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/etc/ufw
ProtectHome=true
# IMPORTANT: Do not enable NoNewPrivileges=true here.
# The application must use sudo -n to run /usr/sbin/ufw as root.

[Install]
WantedBy=multi-user.target
